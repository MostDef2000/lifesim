# ВЛ1: Рейнеке — env-шаблон (015-deploy-kit). Скопируйте в /opt/lifesim/.env
# ВНИМАНИЕ: это шаблон. Никогда не коммитьте реальный .env.

# --- Секреты ---
# HMAC-секрет сессий. Сгенерируйте НА сервере: openssl rand -hex 32
# и подставьте 64 hex-символа вручную. Значение не коммитить и не пересылать.
VL1_SECRET=REPLACE_ME_WITH_64_HEX_CHARS

# --- Приложение ---
LIFESIM_CONFIG=config/production.yaml
LIFESIM_DB=data/lifesim.db

# --- Флаги-кейстоуны (П2: все эксперименты выключены по умолчанию) ---
# Погода: synthetic = детерминированная; historical = реальная погода Рейнеке год назад (Open-Meteo)
weather__source=synthetic
# Огонь: самовоспламенение выключено
fire__spontaneous_chance_per_day=0.0
# NPC-поездки и динамические цены внешних сервисов — выключены
external__npc_utility=false
external__supply_demand=false
# Портреты (M6): выключены; включите при наличии Flux-бэкенда
visual__enabled=false
# LLM-диалоги (M4): выключены — детерминированные fallback-ответы
llm__enabled=false
