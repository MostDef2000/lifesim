#!/usr/bin/env bash
#
# lifesim-deploy-wrapper — forced-command LAUNCHER (минимальный привилегированный
# вход, пользователь deploy).
#
# Install path : /usr/local/sbin/lifesim-deploy-wrapper (root:root, mode 0755)
#
# Публичный ключ деплоя ставится в authorized_keys пользователя deploy с
# forced command (другого канала ключ не открывает):
#
#   command="/usr/local/sbin/lifesim-deploy-wrapper",no-pty,no-agent-forwarding,no-X11-forwarding,no-port-forwarding ssh-ed25519 AAAA... lifesim-deploy@ci
#
# ДОПУСТИМЫЕ КОМАНДЫ (exact-match по регулярке, без eval; всё прочее — отказ):
#   lifesim-deploy-v1 <40-hex sha>   — деплой коммита (см. deploy/README.md §9)
#   lifesim-status-v1                — read-only отчёт (транспорт + состояние)
#
# РАЗДЕЛЕНИЕ LAUNCHER/ENGINE (T2): этот файл — ТОЛЬКО лаунчер: валидация
# verb+SHA, single-flight flock, открытие engine'а, version-gate, передача кода
# возврата. Деплой-логики здесь нет, повышенных вызовов нет (гранты —
# deploy/README.md §9.1, использует их engine). Вся мутабельная логика живёт в
# $APP_DIR/deploy/deploy-engine (unprivileged engine в чек-ауте) и обновляется
# КАЖДЫМ lane-A деплоем: лаунчер запускает engine из чек-аута по fd, поэтому
# выполняемый деплой обновляет сам engine — chicken-egg устранён.
#
# КОНТРАКТ ENGINE (fail-closed):
#   exec 8< "$ENGINE_PATH"          # закрепление inode engine'а на момент запуска
#   bash /proc/self/fd/8 --version  # гейт: вывод содержит interface=1
#                                   # (жёстко зашитый список ниже; иначе отказ)
#   LIFESIM_DEPLOY_LOCK_FD=9 LIFESIM_DEPLOY_ENGINE_FD=8 \
#       bash /proc/self/fd/8 deploy-v1 <sha>   |   status-v1
# Код возврата engine'а передаётся вызывающему БЕЗ ИЗМЕНЕНИЙ. Engine сам
# отказывается работать без LIFESIM_DEPLOY_LOCK_FD — прямой вызов движка
# блокируется по умолчанию (проверка LIFESIM_DEPLOY_LOCK_FD); single-flight —
# конкурентный барьер, а не изоляционный: локальный вызов с подделанным
# открытым fd возможен и не является security-границей. Замок: fd 9
# (STATE_DIR/apply.lock, flock -w LOCK_WAIT) берётся ЗДЕСЬ, до выбора engine'а;
# параллельный вызов ждёт до LOCK_WAIT секунд и отваливается.
#
# УСТАНОВКА / МИГРАЦИЯ / BREAK-GLASS: deploy/README.md §9.1 — однократная
# ручная установка (Lane B) на каждое ИЗМЕНЕНИЕ ЭТОГО ФАЙЛА; engine вручную не
# устанавливается никогда; break-glass — возврат .bak-копии старого враппера.
# Drill'ы: переопределяются только LIFESIM_DEPLOY_APP_DIR / STATE_DIR / LOCK_WAIT.

set -Eeuo pipefail

# ---- конфигурация (переопределяется только для drill'ов; прод — дефолты) --- #
APP_DIR="${LIFESIM_DEPLOY_APP_DIR:-/opt/lifesim}"
STATE_DIR="${LIFESIM_DEPLOY_STATE_DIR:-/opt/lifesim/deploy-state}"
LAUNCHER_PATH="/usr/local/sbin/lifesim-deploy-wrapper"   # путь инсталляции, константа
ENGINE_PATH="$APP_DIR/deploy/deploy-engine"               # engine живёт в чек-ауте
STATE_LOCK="$STATE_DIR/apply.lock"
LOCK_WAIT="${LIFESIM_DEPLOY_LOCK_WAIT:-300}"              # сек ожидания flock

# Жёстко зашитый список поддерживаемых интерфейсов engine'а; любое другое
# значение interface= в выводе `--version` — fail-closed.
ACCEPTED_ENGINE_INTERFACES="1"

on_err() {
    local ec=$?
    # ${BASH_LINENO[1]} — строка отказа в кадре вызывающего (сам трап — кадр 0).
    echo "WRAP-ERR: unexpected failure (status ${ec}): ${BASH_COMMAND:-?} at line ${BASH_LINENO[1]:-unknown}" >&2
    exit 1
}
trap on_err ERR

err() { echo "WRAP-ERR: $*" >&2; exit 1; }

require_sha() {
    [[ "$1" =~ ^[0-9a-f]{40}$ ]] || err "invalid sha: expected 40 lowercase hex"
}

# sha256 файла первой строкой вывода; сбой → rc 1 (не глушится).
compute_sha() {
    local h
    read -r h _ <<<"$(sha256sum -- "$1" 2>/dev/null)" || return 1
    [ -n "$h" ] || return 1
    printf '%s\n' "$h"
}

# Транспортный отчёт для status-v1: печатается ДО тела engine'а. lsha/esha
# недоступны (drill-пути, нет файла) → "unavailable", но статус не роняем.
print_transport() {  # ${1:-} — engine_error (пусто = ok)
    local lsha esha
    lsha="$(compute_sha "$LAUNCHER_PATH")" || lsha="unavailable"
    esha="$(compute_sha /proc/self/fd/8)" || esha="unavailable"
    echo "== transport =="
    echo "launcher_path=${LAUNCHER_PATH}"
    echo "launcher_sha256=${lsha}"
    echo "launcher_interface=lifesim-launcher-v1"
    echo "engine_path=${ENGINE_PATH}"
    echo "engine_open_sha256=${esha}"
    echo "engine_version=${ENGINE_VERSION:-<unavailable>}"
    echo "engine_interface=${ENGINE_IFACE:-none}"
    echo "engine_lock_fd=held"
    if [ -n "${1:-}" ]; then
        echo "engine_error=${1}"
    fi
    return 0
}

engine_fail() {  # <msg> — fail-closed: молча пропустить сбой engine'а нельзя
    if [ "$MODE" = "status" ]; then
        print_transport "$1"
    else
        echo "WRAP-ERR: $1" >&2
    fi
    exit 1
}

open_lock() {
    [ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR" || err "cannot create state dir: $STATE_DIR"
    exec 9>"$STATE_LOCK" || err "cannot open apply lock: $STATE_LOCK"
    flock -w "$LOCK_WAIT" 9 || err "another deploy holds the lock (waited ${LOCK_WAIT}s)"
}

open_engine() {
    # ВАЖНО: у exec редиректы действуют В ТЕКУЩЕМ шелле насовсем — `exec 8<f 2>/dev/null`
    # навсегда уводит stderr лаунчера в /dev/null и диагностика engine_fail
    # становится невидимой. Поэтому сначала доступность файла проверяем обычной
    # командой (`: <file` — перенаправление скоупится на команду, ловится через if,
    # не оставляет побочек), и только потом голый exec без переопределения stderr:
    # оставшийся режим отказа экзотичен и остаётся fail-closed (bash-ошибка + rc≠0).
    # Косметика: при сбое bash может сперва напечатать собственное "No such file or directory"
    # (порядок редиректов), до транспорта/диагностики — fail-closed это не затрагивает.
    if ! : <"$ENGINE_PATH" 2>/dev/null; then
        engine_fail "cannot open deploy engine: ${ENGINE_PATH}"
    fi
    exec 8<"$ENGINE_PATH"
}

# Version-gate: `--version` обязан завершиться успехом И сообщить interface= из
# жёстко зашитого списка (парс значения исключает и подстрочные ложные срабатывания).
gate_engine() {
    local rc=0
    ENGINE_VERSION="$(bash /proc/self/fd/8 --version 2>/dev/null)" || rc=$?
    ENGINE_IFACE="${ENGINE_VERSION#*interface=}"
    ENGINE_IFACE="${ENGINE_IFACE%%[!0-9]*}"
    [ "$rc" -eq 0 ] || engine_fail "deploy-engine --version failed (rc=${rc})"
    [ -n "$ENGINE_IFACE" ] || engine_fail "deploy-engine --version: no interface= in output: ${ENGINE_VERSION:-<no output>}"
    [[ " ${ACCEPTED_ENGINE_INTERFACES} " == *" ${ENGINE_IFACE} "* ]] \
        || engine_fail "unsupported deploy-engine interface=${ENGINE_IFACE} (accepted: ${ACCEPTED_ENGINE_INTERFACES})"
}

run_engine() {  # $@ — аргументы engine'а; код возврата передаётся verbatim
    LIFESIM_DEPLOY_LOCK_FD=9 LIFESIM_DEPLOY_ENGINE_FD=8 \
        bash /proc/self/fd/8 "$@" || exit $?
}

# ---------------------------------------------------------------------------- #
# dispatch: exact-match allowlist, без eval, без sh -c от ввода клиента
# ---------------------------------------------------------------------------- #
main() {
    local cmd="${SSH_ORIGINAL_COMMAND:-}" sha=""
    if [[ "$cmd" =~ ^lifesim-deploy-v1\ ([0-9a-f]{40})$ ]]; then
        sha="${BASH_REMATCH[1]}"
        require_sha "$sha"
        MODE="deploy"
    elif [[ "$cmd" == "lifesim-status-v1" ]]; then
        MODE="status"
    else
        err "command not allowed"
    fi

    open_lock      # single-flight ДО выбора engine'а
    open_engine
    gate_engine

    if [ "$MODE" = "deploy" ]; then
        run_engine deploy-v1 "$sha"
    else
        print_transport
        run_engine status-v1
    fi
    exit 0
}

# Инструменты, без которых лаунчер бессмысленен (fail fast; всё остальное —
# забота engine'а). Всё остальное — деплой-логика в engine'е.
for _tool in flock sha256sum bash; do
    command -v "$_tool" >/dev/null 2>&1 || err "missing tool: $_tool"
done
unset _tool

MODE=""
ENGINE_VERSION=""
ENGINE_IFACE=""
main "$@"
